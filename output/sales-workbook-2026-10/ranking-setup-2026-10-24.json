  {
    "updateCells": {
      "start": {
        "sheetId": 6042401,
        "rowIndex": 6,
        "columnIndex": 13
      },
      "rows": [
        {
          "values": [
            {
              "userEnteredValue": {
                "formulaValue": "=SORT(UNIQUE(TOCOL({\"ASESOR INSTITUTO\";IFERROR(FILTER(ASESORAS!$B$3:$B$102,ASESORAS!$F$3:$F$102=\"Activo\"),\"\");IFERROR(FILTER(IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$T$3:$T$5001,'BASE GENERAL'!$I$3:$I$5001),'BASE GENERAL'!$Q$3:$Q$5001<>\"\",((('BASE GENERAL'!$S$3:$S$5001=\"SI\")+('BASE GENERAL'!$H$3:$H$5001=\"VENTA\")+('BASE GENERAL'!$H$3:$H$5001=\"VENTA SOLO\"))>0),IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$U$3:$U$5001,'BASE GENERAL'!$Z$3:$Z$5001)>=$B$3,IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$U$3:$U$5001,'BASE GENERAL'!$Z$3:$Z$5001)<EDATE($B$3,1)),\"\")},1)))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",SUMPRODUCT(N('BASE GENERAL'!$Q$3:$Q$5001<>\"\"),N(((('BASE GENERAL'!$S$3:$S$5001=\"SI\")+('BASE GENERAL'!$H$3:$H$5001=\"VENTA\")+('BASE GENERAL'!$H$3:$H$5001=\"VENTA SOLO\"))>0)),N(IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$U$3:$U$5001,'BASE GENERAL'!$Z$3:$Z$5001)>=$B$3),N(IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$U$3:$U$5001,'BASE GENERAL'!$Z$3:$Z$5001)<EDATE($B$3,1)),N(IF('BASE GENERAL'!$S$3:$S$5001=\"SI\",'BASE GENERAL'!$T$3:$T$5001,'BASE GENERAL'!$I$3:$I$5001)=N7)))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",SUMIFS(METAS!$D$3:$D$1000,METAS!$A$3:$A$1000,$B$3,METAS!$B$3:$B$1000,N7,METAS!$C$3:$C$1000,\"INDIVIDUAL\"))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",IF(P7>0,O7/P7,\"SIN META\"))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",IF(P7>0,MAX(0,P7-O7),\"SIN META\"))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",SUMPRODUCT(N('BASE GENERAL'!$Q$3:$Q$5001<>\"\"),N((('BASE GENERAL'!$I$3:$I$5001=N7)+('BASE GENERAL'!$T$3:$T$5001=N7))>0)))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",COUNTIFS('BASE GENERAL'!$I$3:$I$5001,N7,'BASE GENERAL'!$H$3:$H$5001,\"INTERESADO\"))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",IFERROR(O7/S7,0))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",SUMIFS('BASE GENERAL'!$X$3:$X$5001,'BASE GENERAL'!$T$3:$T$5001,N7,'BASE GENERAL'!$Y$3:$Y$5001,\"PRUEBA\",'BASE GENERAL'!$U$3:$U$5001,\">=\"&$B$3,'BASE GENERAL'!$U$3:$U$5001,\"<\"&EDATE($B$3,1)))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",SUMIFS('BASE GENERAL'!$X$3:$X$5001,'BASE GENERAL'!$T$3:$T$5001,N7,'BASE GENERAL'!$Y$3:$Y$5001,\"ACTIVA\",'BASE GENERAL'!$U$3:$U$5001,\">=\"&$B$3,'BASE GENERAL'!$U$3:$U$5001,\"<\"&EDATE($B$3,1)))"
              }
            },
            {
              "userEnteredValue": {
                "formulaValue": "=IF(N7=\"\",\"\",COUNTIFS('BASE GENERAL'!$T$3:$T$5001,N7,'BASE GENERAL'!$S$3:$S$5001,\"SI\",'BASE GENERAL'!$U$3:$U$5001,\">=\"&$B$3,'BASE GENERAL'!$U$3:$U$5001,\"<\"&EDATE($B$3,1)))"
              }
            }
          ]
        }
      ],
      "fields": "userEnteredValue"
